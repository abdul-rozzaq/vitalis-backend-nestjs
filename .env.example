# [Database Connection]
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/vitalis"

# [JWT Configuration]
JWT_SECRET="super-weak-secret"
JWT_EXPIRES_IN="1d"

# [Server Configuration]
PORT=3000

# [Attendance / Hikvision Face ID]
ATTENDANCE_WEBHOOK_SECRET="your-strong-secret-here"
# HIKVISION_ALLOWED_IPS=192.168.1.12
ATTENDANCE_GRACE_PERIOD_MIN=5

# [Patient App Auth — separate from staff JWT_SECRET on purpose]
PATIENT_JWT_SECRET="super-weak-patient-secret"

# [Eskiz.uz SMS — if unset, OTP codes are logged instead of sent (dev mode)]
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
