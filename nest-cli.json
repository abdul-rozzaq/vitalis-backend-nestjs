{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/prescriptions/templates/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "assets/fonts/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "assets/images/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}