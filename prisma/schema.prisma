// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  KASSIR
  DOCTOR
  HAMSHIRA
  LABARANT
  DIAGNOST
  TEXNIK_HODIM
  DIREKTOR
  HISOBCHI

  @@map("user_roles")
}

model User {
  id         String    @id @default(uuid())
  first_name String    @db.VarChar(64)
  last_name  String    @db.VarChar(64)
  phone      String    @unique @db.VarChar(20)
  password   String
  birthday   DateTime? @db.Date
  photo      String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  role           UserRole               @default(TEXNIK_HODIM)
  assignments    Assignment[]
  labAssignments LaboratoryAssignment[]
  diagnosticAssignments DiagnosticAssignment[]
  auditLogs      AuditLog[]

  balanceTransactions BalanceTransaction[]
  bonusTransactions   BonusTransaction[]
  invoicesCreated     Invoice[]            @relation("InvoiceCreatedBy")
  invoicePayments     InvoicePayment[]     @relation("InvoicePaymentCreatedBy")

  doctorShiftAssignments ShiftAssignment[]    @relation("DoctorShiftAssignments")
  nurseShiftAssignments  ShiftNurse[]         @relation("NurseShiftAssignments")
  doctorShifts           RoomShift[]          @relation("RoomShiftDoctor")
  defaultNurseShifts     ShiftDefaultNurse[]  @relation("ShiftDefaultNurse")

  operationSurgeons OperationSurgeon[] @relation("OperationSurgeons")
  @@map("users")
}

model Region {
  id        String     @id @default(uuid())
  name      String     @unique @db.VarChar(64)
  districts District[]

  @@map("regions")
}

model District {
  id       String    @id @default(uuid())
  name     String    @db.VarChar(64)
  regionId String
  region   Region    @relation(fields: [regionId], references: [id])
  patients Patient[]

  @@unique([name, regionId])
  @@map("districts")
}

enum DocumentType {
  PASSPORT
  BIRTH_CERTIFICATE
  FOREIGN_PASSPORT
  RESIDENCE_PERMIT

  @@map("document_types")
}

enum BloodType {
  O_POSITIVE
  O_NEGATIVE
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE

  @@map("blood_types")
}

model Patient {
  id              String           @id @default(uuid())
  first_name      String           @db.VarChar(64)
  last_name       String           @db.VarChar(64)
  phone_number    String           @db.VarChar(15)
  gender          String           @db.VarChar(10)
  birth_date      DateTime         @db.Date

  address         String?          @db.VarChar(255)
  blood_type      BloodType?       @default(O_POSITIVE)
  document_type   DocumentType?
  document_series String?          @db.VarChar(10)
  document_number String?          @db.VarChar(20)
  pinfl           String?          @unique @db.VarChar(14)
  district        District         @relation(fields: [districtId], references: [id])
  districtId      String
  appointments    Appointment[]
  medicalCards    MedicalCard003[]
  cases           PatientCase[]
  labOrders       LabOrder[]
  diagnosticOrders DiagnosticOrder[]
  wards           Wards[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete uchun maydon

  balance      PatientBalance?
  bonusBalance PatientBonusBalance?
  invoices     Invoice[]
  wardRoundNotes WardRoundPatient[]
  operations Operation[]

  @@index([deletedAt])
  @@map("patients")
}

model MedicalCard003 {
  id String @id @default(uuid())

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  admissionDate DateTime  @db.Date
  dischargeDate DateTime? @db.Date

  wardNumber     String? @db.VarChar(20)
  departmentName String? @db.VarChar(128)
  doctorName     String? @db.VarChar(128)
  nurseName      String? @db.VarChar(128)

  complaints    String? @db.Text
  anamnesis     String? @db.Text
  lifeAnamnesis String? @db.Text

  diagnosisInitial String? @db.VarChar(500)
  diagnosisFinal   String? @db.VarChar(500)

  treatment  String? @db.Text
  dailyNotes Json?   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medical_cards_003")
}

model Department {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(64)
  description String?
  price       Float?

  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  assignments Assignment[]
  rooms       Room[]

  @@map("departments")
}

// ─── Assignments ────────────────────────────────────────────────────────────

enum RoomType {
  WARD // Yotoqxona
  EXAMINATION // Ko'rik xonasi
  OPERATION    

  @@map("room_types")
}

/// Binodagi xonalar (220-xona, Operatsion xona, va h.k.)
model Room {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(64)
  capacity    Int      @default(1)
  description String?
  roomType    RoomType @map("room_type")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignments      Assignment[]
  wards            Wards[]
  shiftRooms       ShiftRoom[]
  shiftAssignments ShiftAssignment[] @relation("RoomShiftAssignments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  operations Operation[]

  @@map("rooms")
}

/// Ish soati — Assignment ga biriktirilgan haftalik jadval qatori
model Schedule {
  id String @id @default(uuid())

  /// 1=Dushanba, 2=Seshanba, ..., 7=Yakshanba
  dayOfWeek Int

  startTime String @db.VarChar(5) // "09:00"
  endTime   String @db.VarChar(5) // "18:00"

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String

  @@map("schedules")
}

/// Xodimni (shifokor / hamshira) departmentga va xonaga biriktirish
model Assignment {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String

  room   Room?   @relation(fields: [roomId], references: [id])
  roomId String?

  schedules    Schedule[]
  appointments Appointment[]
  caseSteps    CaseStep[]

  /// Assignment faolmi yoki yo'qmi
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, departmentId])
  @@map("assignments")
}


model Appointment {
  id         String   @id @default(uuid())
  dateTime   DateTime
  conclusion String?  @db.Text

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String

  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String

  files        AppointmentFile[]
  prescription Prescription?
  caseStep     CaseStep?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model AppointmentFile {
  id            String      @id @default(uuid())
  name          String
  url           String
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@map("appointment_files")
}

// ─── Medicines & Prescriptions ───────────────────────────────────────────────

/// Dori nomi (global katalog)
model Medicine {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(128)
  createdAt DateTime @default(now())

  prescriptionItems PrescriptionItem[]

  @@map("medicines")
}

enum MealRelation {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  AT_SPECIFIC_TIME

  @@map("meal_relations")
}

/// Appointment uchun recept (1:1). appointmentId — old path, caseStepId — new path.
model Prescription {
  id            String       @id @default(uuid())
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  caseStepId    String?      @unique
  caseStep      CaseStep?    @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items PrescriptionItem[]

  @@map("prescriptions")
}

/// Receptdagi bitta dori satri
model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  dosage       String       @db.VarChar(64)
  frequency    Int
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  mealRelation MealRelation
  specificTime String?      @db.VarChar(5)
  note         String?

  @@map("prescription_items")
}

// ─── Patient Case Workflow ───────────────────────────────────────────────────

enum CaseStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("case_statuses")
}

enum CaseStepType {
  CHECKIN
  CONSULTATION
  LAB
  DIAGNOSTIC
  PROCEDURE
  REFERRAL
  DISCHARGE
   OPERATION 

  @@map("case_step_types")
}

enum CaseStepStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("case_step_statuses")
}

model PatientCase {
  id             String     @id @default(uuid())
  patient        Patient    @relation(fields: [patientId], references: [id])
  patientId      String
  status         CaseStatus @default(ACTIVE)
  chiefComplaint String?    @db.Text
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  steps          CaseStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_cases")
}

model CaseStep {
  id            String         @id @default(uuid())
  case          PatientCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String
  type          CaseStepType
  status        CaseStepStatus @default(PENDING)
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id])
  assignmentId  String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  appointmentId String?        @unique
  note          String?        @db.Text
  completedAt   DateTime?
  prescription  Prescription?
  labOrder      LabOrder?
  diagnosticOrder DiagnosticOrder?

  createdAt DateTime @default(now())
operation Operation?

  @@map("case_steps")
}

// ─── Laboratory Orders ───────────────────────────────────────────────────────

enum LabOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("lab_order_statuses")
}

enum LabItemStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED

  @@map("lab_item_statuses")
}

model LabOrder {
  id     String         @id @default(uuid())
  status LabOrderStatus @default(PENDING)

  caseStep   CaseStep @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  caseStepId String   @unique

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String

  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  laboratoryId String

  items LabOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lab_orders")
}
model LabOrderItem {
  id     String        @id @default(uuid())
  status LabItemStatus @default(PENDING)

  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labOrderId String

  service   LaboratoryService @relation(fields: [serviceId], references: [id])
  serviceId String

  fileUrl     String?
  fileName    String?
  note        String?   @db.Text
  completedAt DateTime?

  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  files   LabOrderItemFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lab_order_items")
}

model LabOrderItemFile {
  id             String       @id @default(uuid())
  url            String
  name           String
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  labOrderItemId String
  createdAt      DateTime     @default(now())

  @@map("lab_order_item_files")
}

// ─── Laboratories ─────────────────────────────────────────────────────────────

model Laboratory {
  id          String                 @id @default(uuid())
  name        String                 @db.VarChar(64)
  description String?
  services    LaboratoryService[]
  assignments LaboratoryAssignment[]
  labOrders   LabOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("laboratories")
}

model LaboratoryService {
  id            String         @id @default(uuid())
  name          String         @db.VarChar(64)
  price         Float?
  laboratory    Laboratory     @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  laboratoryId  String
  labOrderItems LabOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("laboratory_services")
}

model LaboratoryAssignment {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  laboratoryId String
  isActive     Boolean    @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, laboratoryId])
  @@map("laboratory_assignments")
}

// ─── Diagnostics ────────────────────────────────────

enum DiagnosticOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("diagnostic_order_statuses")
}

enum DiagnosticItemStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED

  @@map("diagnostic_item_statuses")
}

model DiagnosticOrder {
  id     String                @id @default(uuid())
  status DiagnosticOrderStatus @default(PENDING)

  caseStep   CaseStep @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  caseStepId String   @unique

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String

  diagnostics   Diagnostics @relation(fields: [diagnosticsId], references: [id], onDelete: Cascade)
  diagnosticsId String

  items DiagnosticOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diagnostic_orders")
}

model DiagnosticOrderItem {
  id     String                @id @default(uuid())
  status DiagnosticItemStatus  @default(PENDING)

  diagnosticOrder   DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)
  diagnosticOrderId String

  service   DiagnosticService @relation(fields: [serviceId], references: [id])
  serviceId String

  note        String?   @db.Text
  completedAt DateTime?

  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  files DiagnosticOrderItemFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diagnostic_order_items")
}

model DiagnosticOrderItemFile {
  id                    String              @id @default(uuid())
  url                   String
  name                  String
  diagnosticOrderItem   DiagnosticOrderItem @relation(fields: [diagnosticOrderItemId], references: [id], onDelete: Cascade)
  diagnosticOrderItemId String
  createdAt             DateTime            @default(now())

  @@map("diagnostic_order_item_files")
}

model Diagnostics {
  id          String                  @id @default(uuid())
  name        String                  @db.VarChar(64)
  description String?
  services    DiagnosticService[]
  assignments DiagnosticAssignment[]
  diagnosticOrders DiagnosticOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diagnostics")
}

model DiagnosticService {
  id                  String                @id @default(uuid())
  name                String                @db.VarChar(64)
  price               Float?
  diagnostics         Diagnostics           @relation(fields: [diagnosticsId], references: [id], onDelete: Cascade)
  diagnosticsId       String
  diagnosticOrderItems DiagnosticOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diagnostic_services")
}

model DiagnosticAssignment {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  diagnostics   Diagnostics @relation(fields: [diagnosticsId], references: [id], onDelete: Cascade)
  diagnosticsId String
  isActive      Boolean     @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, diagnosticsId])
  @@map("diagnostic_assignments")
}

enum WardStatus {
  OCCUPIED // Bemor yotibdi
  VACATED // Bemor chiqib ketgan

  @@map("ward_statuses")
}

enum BalanceTxType {
  CREDIT
  DEBIT

  @@map("balance_tx_types")
}

enum BalanceTxSource {
  DEPOSIT
  WARD_DAILY
  APPOINTMENT
  LAB_SERVICE
  INVOICE_PAYMENT
  REFUND
  ADJUSTMENT

  @@map("balance_tx_sources")
}

enum BonusTxType {
  EARN
  SPEND
  EXPIRE

  @@map("bonus_tx_types")
}

enum BonusTxSource {
  REFERRAL
  FIRST_VISIT
  LOYALTY
  PROMOTION
  SERVICE_SPEND

  @@map("bonus_tx_sources")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("invoice_statuses")
}

enum InvoiceSourceType {
  WARD
  APPOINTMENT
  LAB_ORDER
  DIAGNOSTIC_ORDER
  MANUAL
  OPERATION  

  @@map("invoice_source_types")
}

enum InvoiceItemSourceType {
  APPOINTMENT
  LAB_SERVICE
  DIAGNOSTIC_SERVICE
  WARD_DAILY
  MANUAL
  OPERATION

  @@map("invoice_item_source_types")
}



model Wards {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  checkIn          DateTime  @default(now())
  expectedOut      DateTime?
  actualOut        DateTime?
  daysStayed       Int?      @default(0)
  companionsCount  Int       @default(0)  

  note String? @db.Text

  status WardStatus @default(OCCUPIED)

  dailyRate    Decimal? @db.Decimal(15, 2)
  totalCharged Decimal  @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wards")
}

model AuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  entity   String // "Patient", "Prescription"
  entityId String
  action   String // "CREATE", "UPDATE", "DELETE"

  oldValues Json?
  newValues Json?

  timestamp DateTime @default(now())

  @@map("audit_logs")
}

model PatientBalance {
  id        String   @id @default(uuid())
  patientId String   @unique
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt DateTime @updatedAt

  patient      Patient              @relation(fields: [patientId], references: [id])
  transactions BalanceTransaction[]

  @@map("patient_balances")
}

model BalanceTransaction {
  id           String          @id @default(uuid())
  patientId    String
  type         BalanceTxType
  amount       Decimal         @db.Decimal(15, 2)
  balanceAfter Decimal         @db.Decimal(15, 2)
  source       BalanceTxSource
  sourceId     String?
  note         String?
  createdAt    DateTime        @default(now())
  createdById  String

  patientBalance PatientBalance @relation(fields: [patientId], references: [patientId])
  createdBy      User           @relation(fields: [createdById], references: [id])

  @@index([patientId])
  @@index([source, sourceId])
  @@map("balance_transactions")
}

model PatientBonusBalance {
  id        String   @id @default(uuid())
  patientId String   @unique
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt DateTime @updatedAt

  patient      Patient            @relation(fields: [patientId], references: [id])
  transactions BonusTransaction[]

  @@map("patient_bonus_balances")
}

model BonusTransaction {
  id           String        @id @default(uuid())
  patientId    String
  type         BonusTxType
  amount       Decimal       @db.Decimal(15, 2)
  balanceAfter Decimal       @db.Decimal(15, 2)
  source       BonusTxSource
  sourceId     String?
  expiresAt    DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  createdById  String

  bonusBalance PatientBonusBalance @relation(fields: [patientId], references: [patientId])
  createdBy    User                @relation(fields: [createdById], references: [id])

  @@index([patientId])
  @@map("bonus_transactions")
}

model Invoice {
  id          String            @id @default(uuid())
  patientId   String
  status      InvoiceStatus     @default(DRAFT)
  totalAmount Decimal           @db.Decimal(15, 2)
  paidCash    Decimal           @default(0) @db.Decimal(15, 2)
  paidBonus   Decimal           @default(0) @db.Decimal(15, 2)
  dueDate     DateTime?
  note        String?

  sourceType InvoiceSourceType
  sourceId   String

  patient  Patient          @relation(fields: [patientId], references: [id])
  items    InvoiceItem[]
  payments InvoicePayment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  @@index([patientId])
  @@index([sourceType, sourceId])
  @@map("invoices")
}

model InvoiceItem {
  id          String                @id @default(uuid())
  invoiceId   String
  description String                @db.VarChar(255)
  quantity    Int                   @default(1)
  unitPrice   Decimal               @db.Decimal(15, 2)
  totalPrice  Decimal               @db.Decimal(15, 2)
  dateFrom    DateTime?
  dateTo      DateTime?

  sourceType InvoiceItemSourceType
  sourceId   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id          String   @id @default(uuid())
  invoiceId   String
  cashAmount  Decimal  @db.Decimal(15, 2)
  bonusAmount Decimal  @db.Decimal(15, 2)
  totalAmount Decimal  @db.Decimal(15, 2)
  note        String?
  createdAt   DateTime @default(now())
  createdById String

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User    @relation("InvoicePaymentCreatedBy", fields: [createdById], references: [id])

  @@map("invoice_payments")
}

// ─── Dejurniy (Navbat) Tizimi ────────────────────────────────────────────────

enum PatientCondition {
  STABLE
  IMPROVING
  WORSENING
  CRITICAL

  @@map("patient_conditions")
}

/// Smena shabloni — bir nechta xonaga biriktirilishi mumkin
model RoomShift {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(64)
  startHour Int
  endHour   Int
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  color     String?   @db.VarChar(7)
  roundHour Int?

  doctorId String?
  doctor   User?   @relation("RoomShiftDoctor", fields: [doctorId], references: [id])

  rooms         ShiftRoom[]
  defaultNurses ShiftDefaultNurse[]
  assignments   ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_shifts")
}

/// Smena ↔ Xona ko'p-ko'p bog'lanish
model ShiftRoom {
  id          String    @id @default(uuid())
  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])

  @@unique([roomShiftId, roomId])
  @@map("shift_rooms")
}

/// Smena uchun standart hamshiralar
model ShiftDefaultNurse {
  id          String    @id @default(uuid())
  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id], onDelete: Cascade)
  nurseId     String
  nurse       User      @relation("ShiftDefaultNurse", fields: [nurseId], references: [id])

  @@unique([roomShiftId, nurseId])
  @@map("shift_default_nurses")
}

/// Konkret kunlik tayinlov — smena + xona + kun uchun
model ShiftAssignment {
  id          String    @id @default(uuid())
  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id])
  roomId      String
  room        Room      @relation("RoomShiftAssignments", fields: [roomId], references: [id])
  date        DateTime  @db.Date
  doctorId    String
  doctor      User      @relation("DoctorShiftAssignments", fields: [doctorId], references: [id])
  isOverride  Boolean   @default(false)

  nurses ShiftNurse[]
  rounds WardRound[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomShiftId, roomId, date])
  @@map("shift_assignments")
}

model ShiftNurse {
  id                String          @id @default(uuid())
  shiftAssignmentId String
  shiftAssignment   ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  nurseId           String
  nurse             User            @relation("NurseShiftAssignments", fields: [nurseId], references: [id])

  @@unique([shiftAssignmentId, nurseId])
  @@map("shift_nurses")
}

/// Apoxot — smena davomida o'tkaziladigan viziyt
model WardRound {
  id                String          @id @default(uuid())
  shiftAssignmentId String
  shiftAssignment   ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id])
  scheduledAt       DateTime
  completedAt       DateTime?
  notes             String?         @db.Text
  patientNotes      WardRoundPatient[]

  createdAt DateTime @default(now())

  @@map("ward_rounds")
}

/// Apoxotda har bir bemor uchun holat yozuvi
model WardRoundPatient {
  id        String           @id @default(uuid())
  roundId   String
  round     WardRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id])
  condition PatientCondition
  notes     String?          @db.Text

  createdAt DateTime @default(now())

  @@map("ward_round_patients")
}


enum OperationStatus {
  SCHEDULED      // Rejalashtirilgan
  IN_PROGRESS    // Jarayonda
  COMPLETED      // Tugallangan
  CANCELLED      // Bekor qilingan

  @@map("operation_statuses")
}

enum SurgeonRole {
  LEAD            // Bosh jarroh
  ASSISTANT       // Yordamchi jarroh

  @@map("surgeon_roles")
}

model OperationType {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(128)
  description String?  @db.Text
  basePrice   Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true)
 
  items       OperationTypeItem[]
  operations  Operation[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@map("operation_types")
}

model OperationTypeItem {
  id              String        @id @default(uuid())
  operationTypeId String
  operationType   OperationType @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(128)
  price     Decimal @db.Decimal(15, 2)
  isActive  Boolean @default(true)

  operationItems OperationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("operation_type_items")
}

/// Konkret operatsiya
model Operation {
  id              String          @id @default(uuid())
  status          OperationStatus @default(SCHEDULED)

  patient         Patient         @relation(fields: [patientId], references: [id])
  patientId       String

  operationType   OperationType   @relation(fields: [operationTypeId], references: [id])
  operationTypeId String

  room            Room?           @relation(fields: [roomId], references: [id])
  roomId          String?

  caseStep        CaseStep?       @relation(fields: [caseStepId], references: [id])
  caseStepId      String?         @unique

  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?

  note            String?         @db.Text
  totalPrice      Decimal         @default(0) @db.Decimal(15, 2)

  surgeons        OperationSurgeon[]
  items           OperationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("operations")
}


/// Operatsiyaga biriktirilgan jarrohlar
model OperationSurgeon {
  id          String      @id @default(uuid())
  operationId String
  operation   Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  surgeonId   String
  surgeon     User        @relation("OperationSurgeons", fields: [surgeonId], references: [id])
  role        SurgeonRole @default(ASSISTANT)

  @@unique([operationId, surgeonId])
  @@map("operation_surgeons")
}

/// Operatsiyaga kirgan xizmatlar (katalogdan nusxa + override narx)
model OperationItem {
  id                  String            @id @default(uuid())
  operationId         String
  operation           Operation         @relation(fields: [operationId], references: [id], onDelete: Cascade)

  operationTypeItemId String
  operationTypeItem   OperationTypeItem @relation(fields: [operationTypeItemId], references: [id])

  name      String  @db.VarChar(128)  // katalogdan nusxa (o'zgarishi mumkin)
  unitPrice Decimal @db.Decimal(15, 2) // override narx
  quantity  Int     @default(1)
  totalPrice Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("operation_items")
}