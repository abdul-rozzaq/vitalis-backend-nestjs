model Patient {
  id               String               @id @default(uuid())
  first_name       String               @db.VarChar(64)
  last_name        String               @db.VarChar(64)
  phone_number     String?              @db.VarChar(15)
  gender           String               @db.VarChar(10)
  birth_date       DateTime             @db.Date
  address          String?              @db.VarChar(255)
  sourceId         String?
  source           PatientSource?       @relation(fields: [sourceId], references: [id])
  blood_type       BloodType?           @default(O_POSITIVE)
  document_type    DocumentType?
  document_series  String?              @db.VarChar(10)
  document_number  String?              @db.VarChar(20)
  pinfl            String?              @unique @db.VarChar(14)
  districtId       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  appointments     Appointment[]
  diagnosticOrders DiagnosticOrder[]
  invoices         Invoice[]
  labOrders        LabOrder[]
  medicalCards     MedicalCard003[]
  operations       Operation[]
  procedureOrders  ProcedureOrder[]
  balance          PatientBalance?
  bonusBalance     PatientBonusBalance?
  cases            PatientCase[]
  district         District?            @relation(fields: [districtId], references: [id])
  wardRoundNotes   WardRoundPatient[]
  wards            Wards[]

  @@index([deletedAt])
  @@map("patients")
}

model MedicalCard003 {
  id               String    @id @default(uuid())
  patientId        String
  admissionDate    DateTime  @db.Date
  dischargeDate    DateTime? @db.Date
  wardNumber       String?   @db.VarChar(20)
  departmentName   String?   @db.VarChar(128)
  doctorName       String?   @db.VarChar(128)
  nurseName        String?   @db.VarChar(128)
  complaints       String?
  anamnesis        String?
  lifeAnamnesis    String?
  diagnosisInitial String?   @db.VarChar(500)
  diagnosisFinal   String?   @db.VarChar(500)
  treatment        String?
  dailyNotes       Json?     @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_cards_003")
}

enum DocumentType {
  PASSPORT
  BIRTH_CERTIFICATE
  FOREIGN_PASSPORT
  RESIDENCE_PERMIT

  @@map("document_types")
}

model PatientSource {
  id       String    @id @default(uuid())
  name     String    @unique @db.VarChar(128)
  createdAt DateTime @default(now())
  patients Patient[]

  @@map("patient_sources")
}

enum BloodType {
  O_POSITIVE
  O_NEGATIVE
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE

  @@map("blood_types")
}
