/// Qurilmadan kelgan xom hodisa — har bir skan uchun bir yozuv
model AttendanceEvent {
  id            String               @id @default(uuid())
  deviceIp      String               @db.VarChar(45)
  employeeNoStr String               @db.VarChar(50)
  eventAt       DateTime             // Qurilma yuborgan ISO dateTime (Asia/Tashkent ofseti bilan)
  rawStatus     String               @db.VarChar(20) // "checkIn" | "checkOut"
  picturePath   String?              @db.VarChar(500)
  status        AttendanceEventStatus @default(PENDING)
  userId        String?
  recordId      String?              // @unique YO'Q — bir record'ga ko'p event bog'lanishi mumkin
  createdAt     DateTime             @default(now())

  user   User?             @relation(fields: [userId],   references: [id])
  record AttendanceRecord? @relation(fields: [recordId], references: [id])

  @@unique([deviceIp, employeeNoStr, eventAt]) // Idempotency: bir xil event ikki marta yozilmasin
  @@index([userId, eventAt])
  @@map("attendance_events")
}

/// Bir xodimning bir shiftdagi yig'ilgan davomat xulosasi
model AttendanceRecord {
  id                String                @id @default(uuid())
  userId            String
  shiftId           String
  checkInAt         DateTime?
  checkOutAt        DateTime?
  lateMinutes       Int                   @default(0)
  earlyLeaveMinutes Int                   @default(0)
  /// Smena oynasi ichida haqiqatda ichkarida bo'lgan daqiqalar.
  /// Birinchi kirish va oxirgi chiqish ayirmasi EMAS — juftlangan
  /// segmentlar yig'indisi, ya'ni smena o'rtasida chiqib ketish hisobga olinadi.
  workedMinutes     Int                   @default(0)
  /// Smenaning o'tgan qismidan yo'q bo'lgan daqiqalar (kechikish shu ichida).
  absentMinutes     Int                   @default(0)
  status            AttendanceRecordStatus @default(PRESENT)
  note              String?               @db.VarChar(500)
  /// Operator qo'lda kiritgan kirish vaqti — qurilma ishlamay qolgan yoki
  /// xodim skanerlashni unutgan holat uchun. Xom `AttendanceEvent` HECH QACHON
  /// o'zgartirilmaydi; qayta hisoblashda bu qiymat sintetik skan sifatida
  /// qo'shiladi, shuning uchun tuzatish cron ishlaganda ham yo'qolmaydi.
  manualCheckInAt   DateTime?
  manualCheckOutAt  DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user        User                   @relation(fields: [userId],  references: [id])
  shift       Shift                  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  events      AttendanceEvent[] // checkIn, checkOut va qayta skanlar — barchasi shu record'ga bog'liq
  adjustments AttendanceAdjustment[]

  @@unique([userId, shiftId])
  @@index([userId, shiftId])
  @@map("attendance_records")
}

/// Qo'lda tuzatish izi. Har bir o'zgartirish alohida qator — kim, qachon,
/// nimani, nimadan nimaga va nima sababdan o'zgartirgani saqlanadi.
/// Yozuvlar hech qachon o'chirilmaydi va tahrirlanmaydi.
model AttendanceAdjustment {
  id         String    @id @default(uuid())
  recordId   String
  /// "checkInAt" | "checkOutAt"
  field      String    @db.VarChar(20)
  oldValue   DateTime?
  newValue   DateTime?
  reason     String    @db.VarChar(500)
  adjustedBy String
  createdAt  DateTime  @default(now())

  record AttendanceRecord @relation(fields: [recordId],   references: [id], onDelete: Cascade)
  user   User             @relation(fields: [adjustedBy], references: [id])

  @@index([recordId])
  @@map("attendance_adjustments")
}

enum AttendanceEventStatus {
  PENDING
  MATCHED
  UNKNOWN_EMPLOYEE
  NO_SHIFT

  @@map("attendance_event_statuses")
}

enum AttendanceRecordStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  LATE_AND_EARLY_LEAVE
  ABSENT
  /// Chiqish skani yo'q — smena yakunlangan, lekin xodim chiqishda skanerlamagan.
  /// Ilgari bunday yozuv jimgina PRESENT bo'lardi.
  MISSING_CHECKOUT
  /// Kirish skani yo'q — faqat chiqish qayd etilgan.
  MISSING_CHECKIN

  @@map("attendance_record_statuses")
}
