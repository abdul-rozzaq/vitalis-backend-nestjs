model WorkSchedule {
  id           String                @id @default(uuid())
  departmentId String
  name         String // e.g., "ICU July 2026 Schedule"
  startDate    DateTime
  endDate      DateTime
  status       SchedulePublishStatus @default(DRAFT)
  version      Int                   @default(1)
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  department Department            @relation(fields: [departmentId], references: [id])
  createdBy  User                  @relation(fields: [createdById], references: [id])
  shifts     Shift[]
  versions   WorkScheduleVersion[]

  @@map("work_schedules")
}

model WorkScheduleVersion {
  id             String    @id @default(uuid())
  workScheduleId String
  version        Int
  changeSummary  String?
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime  @default(now())

  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  publishedBy  User?        @relation(fields: [publishedById], references: [id])

  @@unique([workScheduleId, version])
  @@map("work_schedule_versions")
}

enum SchedulePublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("schedule_publish_statuses")
}
