model WorkSchedule {
  id           String                @id @default(uuid())
  departmentId String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       SchedulePublishStatus @default(DRAFT)
  version      Int                   @default(1)
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  shifts       Shift[]
  versions     WorkScheduleVersion[]
  createdBy    User                  @relation(fields: [createdById], references: [id])
  department   Department            @relation(fields: [departmentId], references: [id])

  @@map("work_schedules")
}

model WorkScheduleVersion {
  id             String       @id @default(uuid())
  workScheduleId String
  version        Int
  changeSummary  String?
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime     @default(now())
  publishedBy    User?        @relation(fields: [publishedById], references: [id])
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)

  @@unique([workScheduleId, version])
  @@map("work_schedule_versions")
}

enum SchedulePublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("schedule_publish_statuses")
}
