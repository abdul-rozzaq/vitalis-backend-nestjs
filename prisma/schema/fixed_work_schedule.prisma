/// Aniq (doimiy) ish vaqtli xodim uchun shaxsiy jadval — masalan registrator 09:00–17:00, Dush–Juma.
/// Har kuni tungi cron (`FixedSchedulesScheduler`) shu jadval asosida tegishli kunga
/// `Shift` + `ShiftStaff` avtomatik yaratadi, shuning uchun davomat tizimi (faqat
/// ShiftStaff orqali ishlaydi) o'zgarishsiz ushbu xodimlarni ham kuzatadi.
model FixedWorkSchedule {
  id           String   @id @default(uuid())
  userId       String   @unique
  departmentId String
  /// Klinika vaqti (Asia/Tashkent), "HH:mm"
  startTime    String   @db.VarChar(5)
  /// startTime dan kichik yoki teng bo'lsa — smena ertasi kunga o'tadi
  endTime      String   @db.VarChar(5)
  /// Hafta kunlari [1=Dushanba .. 7=Yakshanba]. Bo'sh massiv = har kuni.
  daysOfWeek   Int[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId, isActive])
  @@map("fixed_work_schedules")
}
