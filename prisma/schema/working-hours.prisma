model WorkingHoursLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("WorkingHoursUser", fields: [userId], references: [id])

  date         DateTime @db.Date
  plannedStart Int
  plannedEnd   Int
  plannedHours Float

  actualStart   DateTime?
  actualEnd     DateTime?
  actualHours   Float     @default(0)
  overtimeHours Float     @default(0)

  shiftAssignmentId String?
  shiftAssignment   ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, shiftAssignmentId])
  @@index([userId, date])
  @@map("working_hours_log")
}
