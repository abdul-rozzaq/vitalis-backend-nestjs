model OperationType {
  id           String                @id @default(uuid())
  name         String                @db.VarChar(128)
  description  String?
  basePrice    Decimal               @default(0) @db.Decimal(15, 2)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  departmentId String?
  items        OperationTypeItem[]
  operations   Operation[]
  doctors      OperationTypeDoctor[]
  department   Department?           @relation(fields: [departmentId], references: [id])

  @@map("operation_types")
}

model OperationTypeItem {
  id              String          @id @default(uuid())
  operationTypeId String
  name            String          @db.VarChar(128)
  price           Decimal         @db.Decimal(15, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  operationItems  OperationItem[]
  operationType   OperationType   @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)

  @@map("operation_type_items")
}

model Operation {
  id              String             @id @default(uuid())
  status          OperationStatus    @default(SCHEDULED)
  patientId       String
  operationTypeId String?
  roomId          String?
  departmentId    String?
  caseStepId      String?            @unique
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  note            String?
  contractNumber  String?            @db.VarChar(64)
  basePrice       Decimal            @default(0) @db.Decimal(15, 2)  
  totalPrice      Decimal            @default(0) @db.Decimal(15, 2)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           OperationItem[]
  surgeons        OperationSurgeon[]
  caseStep        CaseStep?          @relation(fields: [caseStepId], references: [id])
  operationType   OperationType?     @relation(fields: [operationTypeId], references: [id])
  patient         Patient            @relation(fields: [patientId], references: [id])
  room            Room?              @relation(fields: [roomId], references: [id])
  department      Department?        @relation(fields: [departmentId], references: [id])

  @@map("operations")
}
model OperationSurgeon {
  id          String      @id @default(uuid())
  operationId String
  surgeonId   String
  role        SurgeonRole @default(ASSISTANT)
  operation   Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  surgeon     User        @relation("OperationSurgeons", fields: [surgeonId], references: [id])

  @@unique([operationId, surgeonId])
  @@map("operation_surgeons")
}

model OperationItem {
  id                  String            @id @default(uuid())
  operationId         String
  operationTypeItemId String
  name                String            @db.VarChar(128)
  unitPrice           Decimal           @db.Decimal(15, 2)
  quantity            Int               @default(1)
  totalPrice          Decimal           @db.Decimal(15, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  operation           Operation         @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationTypeItem   OperationTypeItem @relation(fields: [operationTypeItemId], references: [id])

  @@map("operation_items")
}

enum OperationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("operation_statuses")
}

enum SurgeonRole {
  LEAD
  ASSISTANT

  @@map("surgeon_roles")
}

model OperationTypeDoctor {
  id              String        @id @default(uuid())
  operationTypeId String
  doctorId        String
  createdAt       DateTime      @default(now())
  operationType   OperationType @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)
  doctor          User          @relation("OperationTypeDoctors", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([operationTypeId, doctorId])
  @@map("operation_type_doctors")
}
