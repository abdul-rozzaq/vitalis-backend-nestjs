model User {
  id                    String                 @id @default(uuid())
  first_name            String                 @db.VarChar(64)
  last_name             String                 @db.VarChar(64)
  phone                 String                 @unique @db.VarChar(20)
  password              String
  birthday              DateTime?              @db.Date
  photo                 String?                @db.VarChar(500)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  role                  UserRole               @default(TEXNIK_HODIM)
  assignments           Assignment[]
  auditLogs             AuditLog[]
  balanceTransactions   BalanceTransaction[]
  bonusTransactions     BonusTransaction[]
  diagnosticAssignments DiagnosticAssignment[]
  invoicePayments       InvoicePayment[]       @relation("InvoicePaymentCreatedBy")
  invoicesCreated       Invoice[]              @relation("InvoiceCreatedBy")
  performedLabItems     LabOrderItem[]         @relation("LabOrderItemPerformedBy")
  labAssignments        LaboratoryAssignment[]
  operationSurgeons     OperationSurgeon[]     @relation("OperationSurgeons")
  operationTypeDoctors  OperationTypeDoctor[]  @relation("OperationTypeDoctors")
  shiftAssignments      ShiftAssignment[]
  shiftStaff            ShiftStaff[]           @relation("ShiftStaffAssignments")
  availabilities        StaffAvailability[]
  timeOffs              StaffTimeOff[]
  publishedSchedules    WorkScheduleVersion[]
  createdSchedules      WorkSchedule[]

  @@map("users")
}

enum UserRole {
  ADMIN
  KASSIR
  DOCTOR
  HAMSHIRA
  LABARANT
  TEXNIK_HODIM
  DIREKTOR
  HISOBCHI
  DIAGNOST

  @@map("user_roles")
}
