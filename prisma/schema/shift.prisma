model Shift {
  id              String             @id @default(uuid())
  departmentId    String
  startAt         DateTime
  endAt           DateTime
  requiredDoctors Int                @default(1)
  requiredNurses  Int                @default(1)
  note            String?            @db.VarChar(500)
  status          ShiftStatus        @default(SCHEDULED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  workScheduleId  String?
  assignments     ShiftAssignment[]
  requirements    ShiftRequirement[]
  staff           ShiftStaff[]
  department      Department         @relation(fields: [departmentId], references: [id])
  workSchedule    WorkSchedule?      @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  rounds          WardRound[]

  @@index([departmentId, startAt, endAt])
  @@map("shifts")
}

model ShiftRequirement {
  id            String    @id @default(uuid())
  shiftId       String
  roleId        String
  requiredCount Int       @default(1)
  role          StaffRole @relation(fields: [roleId], references: [id])
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, roleId])
  @@map("shift_requirements")
}

model ShiftAssignment {
  id        String    @id @default(uuid())
  shiftId   String
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  role      StaffRole @relation(fields: [roleId], references: [id])
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@index([userId])
  @@map("shift_assignments")
}

model ShiftStaff {
  id      String         @id @default(uuid())
  shiftId String
  userId  String
  /// Qaysi kvotani band qilyapti: DOCTOR yoki NURSE
  role    ShiftStaffRole
  shift   Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user    User           @relation("ShiftStaffAssignments", fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@map("shift_staff")
}

model WardRound {
  id           String             @id @default(uuid())
  scheduledAt  DateTime
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  shiftId      String
  patientNotes WardRoundPatient[]
  shift        Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("ward_rounds")
}

model WardRoundPatient {
  id        String           @id @default(uuid())
  roundId   String
  patientId String
  condition PatientCondition
  notes     String?
  createdAt DateTime         @default(now())
  patient   Patient          @relation(fields: [patientId], references: [id])
  round     WardRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("ward_round_patients")
}

enum PatientCondition {
  STABLE
  IMPROVING
  WORSENING
  CRITICAL

  @@map("patient_conditions")
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("shift_statuses")
}

enum ShiftStaffRole {
  DOCTOR
  NURSE

  @@map("shift_staff_roles")
}
