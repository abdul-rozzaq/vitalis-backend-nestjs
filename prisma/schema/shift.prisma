model Shift {
  id              String             @id @default(uuid())
  departmentId    String
  startAt         DateTime // to'liq timestamp (smena boshlanishi)
  endAt           DateTime // to'liq timestamp (tugash — ertasi kun bo'lishi mumkin)
  requiredDoctors Int                @default(1)
  requiredNurses  Int                @default(1)
  note            String?            @db.VarChar(500)
  status          ShiftStatus        @default(SCHEDULED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  department        Department         @relation(fields: [departmentId], references: [id])
  staff             ShiftStaff[]
  rounds            WardRound[]
  attendanceRecords AttendanceRecord[]

  /// Bulk generatsiya idempotent bo'lishi uchun: bir bo'limda bir xil
  /// boshlanish/tugash vaqtiga ega ikkinchi smena yaratilmaydi.
  @@unique([departmentId, startAt, endAt])
  @@index([departmentId, startAt, endAt])
  @@map("shifts")
}

model ShiftStaff {
  id      String         @id @default(uuid())
  shiftId String
  userId  String
  /// Qaysi kvotani band qilyapti: DOCTOR yoki NURSE
  role    ShiftStaffRole
  shift   Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user    User           @relation("ShiftStaffAssignments", fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@index([userId])
  @@map("shift_staff")
}

model WardRound {
  id           String             @id @default(uuid())
  shiftId      String
  scheduledAt  DateTime
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  patientNotes WardRoundPatient[]
  shift        Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("ward_rounds")
}

model WardRoundPatient {
  id        String           @id @default(uuid())
  roundId   String
  patientId String
  condition PatientCondition
  notes     String?
  createdAt DateTime         @default(now())
  patient   Patient          @relation(fields: [patientId], references: [id])
  round     WardRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("ward_round_patients")
}

enum PatientCondition {
  STABLE
  IMPROVING
  WORSENING
  CRITICAL

  @@map("patient_conditions")
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("shift_statuses")
}

enum ShiftStaffRole {
  DOCTOR
  NURSE

  @@map("shift_staff_roles")
}
