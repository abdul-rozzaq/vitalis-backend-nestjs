enum PatientCondition {
  STABLE
  IMPROVING
  WORSENING
  CRITICAL

  @@map("patient_conditions")
}

enum ShiftOverrideType {
  FULL_OVERRIDE
  SWAP
  PARTIAL_TRANSFER
  OVERTIME

  @@map("shift_override_types")
}

model RoomShift {
  id        String @id @default(uuid())
  name      String @db.VarChar(64)
  startHour Int
  endHour   Int

  // Minut aniqligi (0 = mavjud integer-only xatti-harakat)
  startMinute Int @default(0)
  endMinute   Int @default(0)

  // Haftalik recurrence bitmask: NULL = har kuni
  // bit 0=Du, 1=Se, 2=Ch, 3=Pa, 4=Ju, 5=Sh, 6=Ya
  // Misol: 31 = Du-Ju, 96 = Sh-Ya, 127 = har kuni
  weekdayMask Int?

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  color     String?   @db.VarChar(7)
  roundHour Int?

  doctorId String?
  doctor   User?   @relation("RoomShiftDoctor", fields: [doctorId], references: [id])

  rooms         ShiftRoom[]
  defaultNurses ShiftDefaultNurse[]
  assignments   ShiftAssignment[]
  changeEvents  ShiftChangeEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_shifts")
}

model ShiftRoom {
  id          String    @id @default(uuid())
  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])

  @@unique([roomShiftId, roomId])
  @@map("shift_rooms")
}

model ShiftDefaultNurse {
  id          String    @id @default(uuid())
  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id], onDelete: Cascade)
  nurseId     String
  nurse       User      @relation("ShiftDefaultNurse", fields: [nurseId], references: [id])

  @@unique([roomShiftId, nurseId])
  @@map("shift_default_nurses")
}

model ShiftAssignment {
  id          String    @id @default(uuid())
  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id])
  roomId      String
  room        Room      @relation("RoomShiftAssignments", fields: [roomId], references: [id])
  date        DateTime  @db.Date
  doctorId    String
  doctor      User      @relation("DoctorShiftAssignments", fields: [doctorId], references: [id])
  isOverride  Boolean   @default(false)

  // Yangi: override turi va qo'shimcha ma'lumotlar
  overrideType  ShiftOverrideType?
  overrideStart Int? // PARTIAL_TRANSFER / OVERTIME uchun soat
  overrideEnd   Int? // PARTIAL_TRANSFER / OVERTIME uchun soat

  // SWAP: o'zaro havola
  swappedWithId String?
  swappedWith   ShiftAssignment?  @relation("SwapPair", fields: [swappedWithId], references: [id])
  swapInverse   ShiftAssignment[] @relation("SwapPair")

  // PARTIAL_TRANSFER: ota assignment
  parentAssignmentId String?
  parent             ShiftAssignment?  @relation("SplitChildren", fields: [parentAssignmentId], references: [id])
  children           ShiftAssignment[] @relation("SplitChildren")

  // Audit
  requestedById String?
  requestedBy   User?   @relation("ShiftChangeRequester", fields: [requestedById], references: [id])
  reason        String? @db.VarChar(500)

  nurses           ShiftNurse[]
  rounds           WardRound[]
  changeEvents     ShiftChangeEvent[]
  workingHoursLogs WorkingHoursLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomShiftId, roomId, date])
  @@map("shift_assignments")
}

model ShiftNurse {
  id                String          @id @default(uuid())
  shiftAssignmentId String
  shiftAssignment   ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  nurseId           String
  nurse             User            @relation("NurseShiftAssignments", fields: [nurseId], references: [id])

  @@unique([shiftAssignmentId, nurseId])
  @@map("shift_nurses")
}

model WardRound {
  id                String             @id @default(uuid())
  shiftAssignmentId String
  shiftAssignment   ShiftAssignment    @relation(fields: [shiftAssignmentId], references: [id])
  scheduledAt       DateTime
  completedAt       DateTime?
  notes             String?            @db.Text
  patientNotes      WardRoundPatient[]

  createdAt DateTime @default(now())

  @@map("ward_rounds")
}

model WardRoundPatient {
  id        String           @id @default(uuid())
  roundId   String
  round     WardRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id])
  condition PatientCondition
  notes     String?          @db.Text

  createdAt DateTime @default(now())

  @@map("ward_round_patients")
}
