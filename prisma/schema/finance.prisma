enum BalanceTxType {
  CREDIT
  DEBIT

  @@map("balance_tx_types")
}

enum BalanceTxSource {
  DEPOSIT
  WARD_DAILY
  APPOINTMENT
  LAB_SERVICE
  INVOICE_PAYMENT
  REFUND
  ADJUSTMENT

  @@map("balance_tx_sources")
}

enum BonusTxType {
  EARN
  SPEND
  EXPIRE

  @@map("bonus_tx_types")
}

enum BonusTxSource {
  REFERRAL
  FIRST_VISIT
  LOYALTY
  PROMOTION
  SERVICE_SPEND

  @@map("bonus_tx_sources")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("invoice_statuses")
}

enum InvoiceSourceType {
  WARD
  APPOINTMENT
  LAB_ORDER
  MANUAL
  OPERATION

  @@map("invoice_source_types")
}

enum InvoiceItemSourceType {
  APPOINTMENT
  LAB_SERVICE
  WARD_DAILY
  MANUAL
  OPERATION

  @@map("invoice_item_source_types")
}

model PatientBalance {
  id        String   @id @default(uuid())
  patientId String   @unique
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt DateTime @updatedAt

  patient      Patient              @relation(fields: [patientId], references: [id])
  transactions BalanceTransaction[]

  @@map("patient_balances")
}

model BalanceTransaction {
  id           String          @id @default(uuid())
  patientId    String
  type         BalanceTxType
  amount       Decimal         @db.Decimal(15, 2)
  balanceAfter Decimal         @db.Decimal(15, 2)
  source       BalanceTxSource
  sourceId     String?
  note         String?
  createdAt    DateTime        @default(now())
  createdById  String

  patientBalance PatientBalance @relation(fields: [patientId], references: [patientId])
  createdBy      User           @relation(fields: [createdById], references: [id])

  @@index([patientId])
  @@index([source, sourceId])
  @@map("balance_transactions")
}

model PatientBonusBalance {
  id        String   @id @default(uuid())
  patientId String   @unique
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt DateTime @updatedAt

  patient      Patient            @relation(fields: [patientId], references: [id])
  transactions BonusTransaction[]

  @@map("patient_bonus_balances")
}

model BonusTransaction {
  id           String        @id @default(uuid())
  patientId    String
  type         BonusTxType
  amount       Decimal       @db.Decimal(15, 2)
  balanceAfter Decimal       @db.Decimal(15, 2)
  source       BonusTxSource
  sourceId     String?
  expiresAt    DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  createdById  String

  bonusBalance PatientBonusBalance @relation(fields: [patientId], references: [patientId])
  createdBy    User                @relation(fields: [createdById], references: [id])

  @@index([patientId])
  @@map("bonus_transactions")
}

model Invoice {
  id          String        @id @default(uuid())
  patientId   String
  status      InvoiceStatus @default(DRAFT)
  totalAmount Decimal       @db.Decimal(15, 2)
  paidCash    Decimal       @default(0) @db.Decimal(15, 2)
  paidBonus   Decimal       @default(0) @db.Decimal(15, 2)
  dueDate     DateTime?
  note        String?

  sourceType InvoiceSourceType
  sourceId   String

  patient  Patient          @relation(fields: [patientId], references: [id])
  items    InvoiceItem[]
  payments InvoicePayment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  @@index([patientId])
  @@index([sourceType, sourceId])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String
  description String    @db.VarChar(255)
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(15, 2)
  totalPrice  Decimal   @db.Decimal(15, 2)
  dateFrom    DateTime?
  dateTo      DateTime?

  sourceType InvoiceItemSourceType
  sourceId   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id          String   @id @default(uuid())
  invoiceId   String
  cashAmount  Decimal  @db.Decimal(15, 2)
  bonusAmount Decimal  @db.Decimal(15, 2)
  totalAmount Decimal  @db.Decimal(15, 2)
  note        String?
  createdAt   DateTime @default(now())
  createdById String

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User    @relation("InvoicePaymentCreatedBy", fields: [createdById], references: [id])

  @@map("invoice_payments")
}
