model Wards {
  id              String     @id @default(uuid())
  patientId       String
  roomId          String
  checkIn         DateTime   @default(now())
  expectedOut     DateTime?
  actualOut       DateTime?
  daysStayed      Int?       @default(0)
  companionsCount Int        @default(0)
  note            String?
  status          WardStatus @default(OCCUPIED)
  dailyRate       Decimal?   @db.Decimal(15, 2)
  totalCharged    Decimal    @default(0) @db.Decimal(15, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  patient         Patient    @relation(fields: [patientId], references: [id])
  room            Room       @relation(fields: [roomId], references: [id])

  @@map("wards")
}

enum WardStatus {
  OCCUPIED
  VACATED

  @@map("ward_statuses")
}
