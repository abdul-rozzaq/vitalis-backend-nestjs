enum MealRelation {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  AT_SPECIFIC_TIME

  @@map("meal_relations")
}

model Medicine {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(128)
  createdAt DateTime @default(now())

  prescriptionItems PrescriptionItem[]

  @@map("medicines")
}

/// appointmentId — old path, caseStepId — new path
model Prescription {
  id            String       @id @default(uuid())
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  caseStepId    String?      @unique
  caseStep      CaseStep?    @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  dosage       String       @db.VarChar(64)
  frequency    Int
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  mealRelation MealRelation
  specificTime String?      @db.VarChar(5)
  note         String?

  @@map("prescription_items")
}
