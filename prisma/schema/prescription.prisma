model Medicine {
  id                String             @id @default(uuid())
  name              String             @unique @db.VarChar(128)
  createdAt         DateTime           @default(now())
  prescriptionItems PrescriptionItem[]

  @@map("medicines")
}

/// appointmentId — old path, caseStepId — new path
model Prescription {
  id            String             @id @default(uuid())
  appointmentId String?            @unique
  caseStepId    String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         PrescriptionItem[]
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  caseStep      CaseStep?          @relation(fields: [caseStepId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String       @db.VarChar(64)
  frequency      Int
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  mealRelation   MealRelation
  specificTime   String?      @db.VarChar(5)
  note           String?
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

enum MealRelation {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  AT_SPECIFIC_TIME

  @@map("meal_relations")
}
