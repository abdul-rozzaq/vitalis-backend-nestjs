model ShiftNotification {
  id        String         @id @default(uuid())
  userId    String
  type      ShiftNotifType
  payload   Json
  readAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation("ShiftNotificationUser", fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("shift_notifications")
}

enum ShiftNotifType {
  SWAP_REQUESTED
  SWAP_APPROVED
  SWAP_REJECTED
  SHIFT_CHANGED
  SHIFT_REMINDER

  @@map("shift_notif_types")
}
