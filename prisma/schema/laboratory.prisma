model Laboratory {
  id          String                 @id @default(uuid())
  name        String                 @db.VarChar(64)
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  labOrders   LabOrder[]
  assignments LaboratoryAssignment[]
  services    LaboratoryService[]

  @@map("laboratories")
}

model LaboratoryService {
  id            String         @id @default(uuid())
  name          String         @db.VarChar(64)
  price         Float?
  laboratoryId  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  labOrderItems LabOrderItem[]
  laboratory    Laboratory     @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  @@map("laboratory_services")
}

model LaboratoryAssignment {
  id           String     @id @default(uuid())
  userId       String
  laboratoryId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, laboratoryId])
  @@map("laboratory_assignments")
}

model LabOrder {
  id           String         @id @default(uuid())
  status       LabOrderStatus @default(PENDING)
  caseStepId   String         @unique
  patientId    String
  laboratoryId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        LabOrderItem[]
  caseStep     CaseStep       @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  laboratory   Laboratory     @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  patient      Patient        @relation(fields: [patientId], references: [id])

  @@map("lab_orders")
}

model LabOrderItem {
  id          String             @id @default(uuid())
  status      LabItemStatus      @default(PENDING)
  labOrderId  String
  serviceId   String
  fileUrl     String?
  fileName    String?
  note        String?
  completedAt DateTime?
  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  files       LabOrderItemFile[]
  labOrder    LabOrder           @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  service     LaboratoryService  @relation(fields: [serviceId], references: [id])

  @@map("lab_order_items")
}

model LabOrderItemFile {
  id             String       @id @default(uuid())
  url            String
  name           String
  labOrderItemId String
  createdAt      DateTime     @default(now())
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)

  @@map("lab_order_item_files")
}

enum LabOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("lab_order_statuses")
}

enum LabItemStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED

  @@map("lab_item_statuses")
}
