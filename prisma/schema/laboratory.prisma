model Laboratory {
  id          String                 @id @default(uuid())
  name        String                 @db.VarChar(64)
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  labOrders   LabOrder[]
  assignments LaboratoryAssignment[]
  services    LaboratoryService[]

  @@map("laboratories")
}

model LaboratoryService {
  id            String         @id @default(uuid())
  name          String         @db.VarChar(64)
  price         Float?
  laboratoryId  String
  defaultRows   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  labOrderItems LabOrderItem[]
  laboratory    Laboratory     @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  @@map("laboratory_services")
}

model LaboratoryAssignment {
  id           String     @id @default(uuid())
  userId       String
  laboratoryId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, laboratoryId])
  @@map("laboratory_assignments")
}

model LabOrder {
  id            String         @id @default(uuid())
  status        LabOrderStatus @default(PENDING)
  caseStepId    String
  patientId     String
  laboratoryId  String
  orderNumber   String?
  sampleTakenAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         LabOrderItem[]
  caseStep      CaseStep       @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  laboratory    Laboratory     @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id])

  @@map("lab_orders")
}

model LabOrderItem {
  id            String             @id @default(uuid())
  status        LabItemStatus      @default(PENDING)
  labOrderId    String
  serviceId     String
  isPaid        Boolean            @default(true)
  // Ushbu xizmat allaqachon biror invoice'ga qo'shilganmi. Bemorni
  // laboratoriyaga yuborishda invois hozircha kechiktirilgan bo'lsa
  // (labarant o'zi narxni belgilab, invois yaratishi kutilsa) false bo'lib
  // yaratiladi; labarant "Invois yaratish" amalini bajarganda true'ga o'tadi.
  invoiced      Boolean            @default(true)
  performedById String?
  fileUrl       String?
  fileName      String?
  note          String?
  completedAt   DateTime?
  startedAt     DateTime?
  readyAt       DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  files         LabOrderItemFile[]
  labOrder      LabOrder           @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  service       LaboratoryService  @relation(fields: [serviceId], references: [id])
  performedBy   User?              @relation("LabOrderItemPerformedBy", fields: [performedById], references: [id])
  resultTable   LabResultTable?

  @@map("lab_order_items")
}

model LabResultTable {
  id             String         @id @default(uuid())
  labOrderItemId String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  labOrderItem   LabOrderItem   @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  rows           LabResultRow[]

  @@map("lab_result_tables")
}

model LabResultRow {
  id        String         @id @default(uuid())
  tableId   String
  code      String?
  indicator String
  result    String
  norm      String?
  unit      String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  table     LabResultTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("lab_result_rows")
}

model LabResultTemplate {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(128)
  rows      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lab_result_templates")
}

model LabOrderItemFile {
  id             String       @id @default(uuid())
  url            String
  name           String
  labOrderItemId String
  createdAt      DateTime     @default(now())
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)

  @@map("lab_order_item_files")
}

enum LabOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("lab_order_statuses")
}

enum LabItemStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED

  @@map("lab_item_statuses")
}
