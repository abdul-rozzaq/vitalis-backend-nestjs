model ShiftTemplate {
  id           String                     @id @default(uuid())
  departmentId String?
  name         String
  startTime    String
  endTime      String
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  requirements ShiftTemplateRequirement[]
  department   Department?                @relation(fields: [departmentId], references: [id])

  @@map("shift_templates")
}

model ShiftTemplateRequirement {
  id            String        @id @default(uuid())
  templateId    String
  roleId        String
  requiredCount Int           @default(1)
  role          StaffRole     @relation(fields: [roleId], references: [id])
  template      ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, roleId])
  @@map("shift_template_requirements")
}
