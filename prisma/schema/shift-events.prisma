enum ShiftEventType {
  SWAP_REQUEST
  SWAP_APPROVED
  SWAP_REJECTED
  FULL_TRANSFER
  PARTIAL_TRANSFER
  OVERTIME_ADDED
  OVERRIDE_CREATED
  OVERRIDE_DELETED

  @@map("shift_event_types")
}

model ShiftChangeEvent {
  id                String          @id @default(uuid())
  eventType         ShiftEventType

  shiftAssignmentId String
  shiftAssignment   ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)

  roomShiftId String
  roomShift   RoomShift @relation(fields: [roomShiftId], references: [id])

  fromDoctorId String
  fromDoctor   User   @relation("ShiftEventFromDoctor", fields: [fromDoctorId], references: [id])

  toDoctorId String?
  toDoctor   User?  @relation("ShiftEventToDoctor", fields: [toDoctorId], references: [id])

  requestedById String
  requestedBy   User   @relation("ShiftEventRequestedBy", fields: [requestedById], references: [id])

  date        DateTime @db.Date
  windowStart Int?
  windowEnd   Int?
  reason      String?  @db.VarChar(500)
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([shiftAssignmentId])
  @@index([fromDoctorId])
  @@index([requestedById])
  @@map("shift_change_events")
}
