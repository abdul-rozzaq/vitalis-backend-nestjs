model DiagnosticOrder {
  id            String                @id @default(uuid())
  status        DiagnosticOrderStatus @default(PENDING)
  caseStepId    String                @unique
  patientId     String
  diagnosticsId String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         DiagnosticOrderItem[]
  caseStep      CaseStep              @relation(fields: [caseStepId], references: [id], onDelete: Cascade)
  diagnostics   Diagnostics           @relation(fields: [diagnosticsId], references: [id], onDelete: Cascade)
  patient       Patient               @relation(fields: [patientId], references: [id])

  @@map("diagnostic_orders")
}

model DiagnosticOrderItem {
  id                String                    @id @default(uuid())
  status            DiagnosticItemStatus      @default(PENDING)
  diagnosticOrderId String
  serviceId         String
  note              String?
  completedAt       DateTime?
  startedAt         DateTime?
  readyAt           DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  files             DiagnosticOrderItemFile[]
  diagnosticOrder   DiagnosticOrder           @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)
  service           DiagnosticService         @relation(fields: [serviceId], references: [id])

  @@map("diagnostic_order_items")
}

model DiagnosticOrderItemFile {
  id                    String              @id @default(uuid())
  url                   String
  name                  String
  diagnosticOrderItemId String
  createdAt             DateTime            @default(now())
  diagnosticOrderItem   DiagnosticOrderItem @relation(fields: [diagnosticOrderItemId], references: [id], onDelete: Cascade)

  @@map("diagnostic_order_item_files")
}

model Diagnostics {
  id               String                 @id @default(uuid())
  name             String                 @db.VarChar(64)
  description      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  assignments      DiagnosticAssignment[]
  diagnosticOrders DiagnosticOrder[]
  services         DiagnosticService[]

  @@map("diagnostics")
}

model DiagnosticService {
  id                   String                @id @default(uuid())
  name                 String                @db.VarChar(64)
  price                Float?
  diagnosticsId        String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  diagnosticOrderItems DiagnosticOrderItem[]
  diagnostics          Diagnostics           @relation(fields: [diagnosticsId], references: [id], onDelete: Cascade)

  @@map("diagnostic_services")
}

model DiagnosticAssignment {
  id            String      @id @default(uuid())
  userId        String
  diagnosticsId String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  diagnostics   Diagnostics @relation(fields: [diagnosticsId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, diagnosticsId])
  @@map("diagnostic_assignments")
}

enum DiagnosticOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("diagnostic_order_statuses")
}

enum DiagnosticItemStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED

  @@map("diagnostic_item_statuses")
}
