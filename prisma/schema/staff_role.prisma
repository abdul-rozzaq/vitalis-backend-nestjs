model StaffRole {
  id                   String                     @id @default(uuid())
  code                 String                     @unique
  name                 String
  description          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  assignments          ShiftAssignment[]
  requirements         ShiftRequirement[]
  templateRequirements ShiftTemplateRequirement[]

  @@map("staff_roles")
}
